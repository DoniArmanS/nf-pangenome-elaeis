/*
========================================================================================
    nf-pangenome-elaise — Nextflow Configuration
========================================================================================
*/

// ─────────────────────────────────────────────────────────────────────────────
// DEFAULT PARAMETERS
// ─────────────────────────────────────────────────────────────────────────────
params {
    // INPUT / OUTPUT
    input         = null          // Path ke file FASTA atau samplesheet CSV
    outdir        = "./results"
    mode          = "full"        // "full" | "graph_only" | "variant_only"

    // PREPROCESSING
    min_seq_len   = 1000          // Filter sekuens < 1kb

    // ALIGNMENT (wfmash)
    segment_len   = 5000          // -s: segment length
    min_map_pct   = 90            // -p: min mapping identity (%)
    n_haplotypes  = 5             // -n: jumlah haplotype

    // GRAPH CONSTRUCTION (seqwish)
    min_match_len = 311           // -k: minimum match length

    // SMOOTHING (smoothxg)
    poa_length    = 700           // -p: POA block length

    // VARIANT CALLING (vg)
    reference     = null          // Reference genome untuk VCF deconstruct
    call_variants = false         // Aktifkan variant calling

    // RESOURCES
    max_memory    = "16.GB"
    max_cpus      = 8
    max_time      = "24.h"
}

// ─────────────────────────────────────────────────────────────────────────────
// PROFILES — Pilih sesuai environment
// ─────────────────────────────────────────────────────────────────────────────
profiles {

    // ── Local (laptop/PC biasa, tanpa HPC) ───────────────────────────────────
    local {
        process.executor       = 'local'
        docker.enabled         = false
        singularity.enabled    = false
        params.max_memory      = "8.GB"
        params.max_cpus        = 4
        params.max_time        = "4.h"
    }

    // ── Docker ───────────────────────────────────────────────────────────────
    docker {
        docker.enabled         = true
        docker.runOptions      = '--rm'
        singularity.enabled    = false
    }

    // ── Singularity (HPC) ────────────────────────────────────────────────────
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }

    // ── SLURM/HPC ────────────────────────────────────────────────────────────
    slurm {
        process.executor       = 'slurm'
        process.queue          = 'normal'
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    // ── Test — real data subset, sumber: tests/test_data/ ───────────────────
    test {
        params.input           = "${projectDir}/tests/test_data/samplesheet.csv"
        params.max_memory      = "4.GB"
        params.max_cpus        = 4
        params.max_time        = "30.m"
        params.n_haplotypes    = 3
        params.segment_len     = 500

        // Override resource labels untuk bisa jalan di laptop
        process {
            withLabel: process_low    { cpus = 1; memory = '2.GB'; time = '10.m' }
            withLabel: process_medium { cpus = 2; memory = '4.GB'; time = '20.m' }
            withLabel: process_high   { cpus = 4; memory = '4.GB'; time = '30.m' }
        }
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// PROCESS DEFAULT SETTINGS
// ─────────────────────────────────────────────────────────────────────────────
process {
    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: process_low {
        cpus   = { 2 * task.attempt }
        memory = { 4.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }

    withLabel: process_medium {
        cpus   = { 4 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withLabel: process_high {
        cpus   = { 8 * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// MANIFEST
// ─────────────────────────────────────────────────────────────────────────────
manifest {
    name            = 'nf-pangenome-elaise'
    author          = 'Doni Arman.S'
    homePage        = 'https://github.com/DoniArmanS/nf-pangenome-elaise'
    description     = 'Nextflow pipeline untuk konstruksi pangenome Elaeis guineensis'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '0.1.0-dev'
}

// ─────────────────────────────────────────────────────────────────────────────
// REPORTING
// ─────────────────────────────────────────────────────────────────────────────
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline.html"
}

report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report.html"
}

trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/trace.tsv"
}

dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/dag.html"
}
