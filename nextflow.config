/*
========================================================================================
    nf-pangenome-elaise — Nextflow Configuration
========================================================================================
*/

// ─────────────────────────────────────────────────────────────────────────────
// DEFAULT PARAMETERS
// ─────────────────────────────────────────────────────────────────────────────
params {
    // INPUT / OUTPUT
    input         = null          // Path ke file FASTA atau samplesheet CSV
    outdir        = "./results"
    mode          = "full"        // "full" | "graph_only" | "variant_only"

    // PREPROCESSING
    min_seq_len       = 500            // Filter sekuens < 500bp (QUAST default)

    // QC — QUAST
    min_contig        = 500            // Panjang minimum contig untuk QUAST

    // KONSTRUKSI GRAPH — Minigraph-Cactus (Hickey et al. 2024)
    reference_name    = null           // WAJIB: nama sample referensi (backbone)
                                       // harus sama dengan nilai 'sample' di samplesheet
    mg_preset         = "ggs"          // minigraph preset: ggs = genome-vs-graph
    mg_min_mapq       = 5             // minigraph: min mapping quality

    // CACTUS — base-level alignment
    cactus_cores      = 8             // core untuk cactus-minigraph

    // VARIANT CALLING — vg
    call_variants     = false          // Aktifkan variant calling dengan vg

    // RESOURCES
    max_memory        = "16.GB"
    max_cpus          = 8
    max_time          = "24.h"
}

// ─────────────────────────────────────────────────────────────────────────────
// PROFILES — Pilih sesuai environment
// ─────────────────────────────────────────────────────────────────────────────
profiles {

    // ── Local (laptop/PC biasa, tanpa HPC) ───────────────────────────────────
    local {
        process.executor       = 'local'
        docker.enabled         = false
        singularity.enabled    = false
        params.max_memory      = "8.GB"
        params.max_cpus        = 4
        params.max_time        = "4.h"
    }

    // ── Docker ───────────────────────────────────────────────────────────────
    docker {
        docker.enabled         = true
        docker.runOptions      = '--rm'
        singularity.enabled    = false
    }

    // ── Singularity (HPC) ────────────────────────────────────────────────────
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }

    // ── SLURM/HPC — pakai conf/hpc.config ──────────────────────────────────
    slurm {
        includeConfig 'conf/hpc.config'
    }

    // ── Conda — pakai environment 'pangenome' yang sudah di-install ────────
    //   Docker juga di-enable agar Cactus (hanya ada sebagai Docker image)
    //   tetap bisa jalan. Proses tanpa 'container' directive pakai conda env.
    conda {
        params.enable_conda = true
        conda.enabled       = true
        process.conda       = "${System.getProperty('user.home')}/miniforge3/envs/pangenome"
        docker.enabled      = true
        docker.runOptions   = '--rm'
    }

    // ── Test — pakai conf/test.config (laptop, resource kecil) ────────────
    test {
        includeConfig 'conf/test.config'
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// PROCESS DEFAULT SETTINGS
// ─────────────────────────────────────────────────────────────────────────────
process {
    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: process_low {
        cpus   = { Math.min( 2 * task.attempt, params.max_cpus as int ) }
        memory = { [4.GB * task.attempt, params.max_memory as nextflow.util.MemoryUnit].min() }
        time   = { 1.h * task.attempt }
    }

    withLabel: process_medium {
        cpus   = { Math.min( 4 * task.attempt, params.max_cpus as int ) }
        memory = { [8.GB * task.attempt, params.max_memory as nextflow.util.MemoryUnit].min() }
        time   = { 4.h * task.attempt }
    }

    withLabel: process_high {
        cpus   = { Math.min( 8 * task.attempt, params.max_cpus as int ) }
        memory = { [16.GB * task.attempt, params.max_memory as nextflow.util.MemoryUnit].min() }
        time   = { 8.h * task.attempt }
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// MANIFEST
// ─────────────────────────────────────────────────────────────────────────────
manifest {
    name            = 'nf-pangenome-elaise'
    author          = 'Doni Arman.S'
    homePage        = 'https://github.com/DoniArmanS/nf-pangenome-elaise'
    description     = 'Nextflow pipeline untuk konstruksi pangenome Elaeis guineensis'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '0.1.0-dev'
}

// ─────────────────────────────────────────────────────────────────────────────
// REPORTING
// ─────────────────────────────────────────────────────────────────────────────
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
}

report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/report.html"
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/trace.tsv"
}

dag {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/dag.html"
}
