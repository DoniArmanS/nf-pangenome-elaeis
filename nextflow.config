/*
========================================================================================
    nf-pangenome-elaise — Nextflow Configuration
========================================================================================
*/

// ─────────────────────────────────────────────────────────────────────────────
// DEFAULT PARAMETERS
// ─────────────────────────────────────────────────────────────────────────────
params {
    // INPUT / OUTPUT
    input         = null          // Path ke file FASTA atau samplesheet CSV
    outdir        = "./results"
    mode          = "full"        // "full" | "graph_only" | "variant_only"

    // PREPROCESSING
    min_seq_len       = 500            // Filter sekuens < 500bp (QUAST default)

    // QC — QUAST
    min_contig        = 500            // Panjang minimum contig untuk QUAST

    // KONSTRUKSI GRAPH — Minigraph-Cactus (Hickey et al. 2024)
    reference_name    = null           // WAJIB: nama sample referensi (backbone)
                                       // harus sama dengan nilai 'sample' di samplesheet
    mg_preset         = "ggs"          // minigraph preset: ggs = genome-vs-graph
    mg_min_mapq       = 5             // minigraph: min mapping quality

    // CACTUS — base-level alignment
    cactus_cores      = 8             // core untuk cactus-minigraph

    // VARIANT CALLING — vg
    call_variants     = false          // Aktifkan variant calling dengan vg

    // RESOURCES
    max_memory        = "16.GB"
    max_cpus          = 8
    max_time          = "24.h"
}

// ─────────────────────────────────────────────────────────────────────────────
// PROFILES — Pilih sesuai environment
// ─────────────────────────────────────────────────────────────────────────────
profiles {

    // ── Local (laptop/PC biasa, tanpa HPC) ───────────────────────────────────
    local {
        process.executor       = 'local'
        docker.enabled         = false
        singularity.enabled    = false
        params.max_memory      = "8.GB"
        params.max_cpus        = 4
        params.max_time        = "4.h"
    }

    // ── Docker ───────────────────────────────────────────────────────────────
    docker {
        docker.enabled         = true
        docker.runOptions      = '--rm'
        singularity.enabled    = false
    }

    // ── Singularity (HPC) ────────────────────────────────────────────────────
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }

    // ── SLURM/HPC ────────────────────────────────────────────────────────────
    slurm {
        process.executor       = 'slurm'
        process.queue          = 'normal'
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    // ── Conda — pakai environment 'pangenome' yang sudah di-install ────────
    conda {
        params.enable_conda = true
        conda.enabled       = true
        process.conda       = "${System.getProperty('user.home')}/miniforge3/envs/pangenome"
    }

    // ── Test — real data subset, sumber: tests/test_data/ ───────────────────
    test {
        params.input          = "${projectDir}/tests/test_data/samplesheet.csv"
        params.reference_name = "EGPMv6"   // kromosom-level, kualitas terbaik
        params.max_memory     = "4.GB"
        params.max_cpus       = 4
        params.max_time       = "30.m"
        params.cactus_cores   = 4

        // Override resource labels untuk laptop
        process {
            withLabel: process_low    { cpus = 1; memory = '2.GB'; time = '10.m' }
            withLabel: process_medium { cpus = 2; memory = '4.GB'; time = '20.m' }
            withLabel: process_high   { cpus = 4; memory = '4.GB'; time = '30.m' }
        }
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// PROCESS DEFAULT SETTINGS
// ─────────────────────────────────────────────────────────────────────────────
process {
    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: process_low {
        cpus   = { 2 * task.attempt }
        memory = { 4.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }

    withLabel: process_medium {
        cpus   = { 4 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withLabel: process_high {
        cpus   = { 8 * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// MANIFEST
// ─────────────────────────────────────────────────────────────────────────────
manifest {
    name            = 'nf-pangenome-elaise'
    author          = 'Doni Arman.S'
    homePage        = 'https://github.com/DoniArmanS/nf-pangenome-elaise'
    description     = 'Nextflow pipeline untuk konstruksi pangenome Elaeis guineensis'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '0.1.0-dev'
}

// ─────────────────────────────────────────────────────────────────────────────
// REPORTING
// ─────────────────────────────────────────────────────────────────────────────
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline.html"
}

report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report.html"
}

trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/trace.tsv"
}

dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/dag.html"
}
