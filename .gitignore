# ==============================================================================
# nf-pangenome-elaeis — .gitignore
# ==============================================================================
# Project ini tinggal clone & jalankan. File di bawah ini TIDAK masuk git
# karena terlalu besar, dibuat otomatis saat runtime, atau bersifat privat.
# ==============================================================================

# ── NEXTFLOW RUNTIME ─────────────────────────────────────────────────────────
.nextflow/
.nextflow.log*
work/
results/
results_*/
output/

# ── DATA GENOME (terlalu besar, download sendiri dari NCBI) ──────────────────
data/*/ncbi_dataset/
data/*/md5sum.txt
tests/medium_data/
data_bench/

# ── CACTUS RUNTIME ───────────────────────────────────────────────────────────
*_jobstore/
jobstore*/
*.hal
*.c2h

# ── FILE BIOINFORMATIKA BESAR ────────────────────────────────────────────────
# (tests/test_data/*.fa sengaja kecil & masuk git untuk testing)
*.fa.gz
*.fasta
*.fasta.gz
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.gfa
*.gfa.gz
*.vcf
*.vcf.gz
*.bam
*.bai
*.sam
*.bed
*.gff
*.gff3
*.gtf
*.paf
*.paf.gz
*.sdf
*.og
*.odgi
*.fna
*.fna.gz

# ── ARCHIVE ──────────────────────────────────────────────────────────────────
*.zip
*.tar
*.tar.gz
*.tar.bz2
*.tgz

# ── DOKUMEN SKRIPSI & PERCAKAPAN (privat, TIDAK masuk GitHub) ────────────────
DATA SKRIPSI/
PROPOSAL SKRIPSI/
ProposalSkripsi/
percakapandosen/
results/
pangenome_results/



# ── PIPELINE OUTPUT ──────────────────────────────────────────────────────────
multiqc_report.html
multiqc_data/
pipeline_info/

# ── PYTHON ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.env
.venv
env/
venv/

# ── SYSTEM & EDITOR ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# ── LOG & TEMP ───────────────────────────────────────────────────────────────
*.log
*.tmp
*.temp
slurm-*.out
sbatch-*.sh
nohup.out

# ── FILE YANG DIBUAT OTOMATIS (tidak perlu di git) ───────────────────────────
seqfile.txt
install_tools.sh
Browser pipeline info/

# ── AI ASSISTANT & CLAUDE CODE ───────────────────────────────────────────────
CLAUDE.md
SKILLS.md
skills-lock.json
.claude/
