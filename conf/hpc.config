/*
 * conf/hpc.config — Konfigurasi untuk HPC Mahameru BRIN
 * Executor : SLURM
 * Partition: medium-small (max 3 hari, sesuai sinfo output)
 * Container: Singularity — Cactus pakai .sif lokal, tools lain pakai conda
 */

params {
    max_cpus   = 32
    max_memory = "64.GB"
    max_time   = "72.h"
}

// Batasi concurrent SLURM submissions supaya tidak kena AssocMaxSubmitJobLimit
// queueSize = max job yang bisa submit sekaligus ke SLURM
executor {
    name            = 'slurm'
    queueSize       = 2          // submit max 2 job SLURM sekaligus
    submitRateLimit = '1/3sec'   // tunggu 3 detik antar submission
    pollInterval    = '30sec'    // cek status job tiap 30 detik
}

process {
    executor = 'slurm'
    queue    = 'medium-small'   // partisi yang tersedia di Mahameru

    withLabel: process_low {
        cpus   = { Math.min(4 * task.attempt, 32) }
        memory = { 8.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    withLabel: process_medium {
        cpus   = { Math.min(8 * task.attempt, 32) }
        memory = { 16.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }

    withLabel: process_high {
        cpus   = { Math.min(16 * task.attempt, 32) }
        memory = { 32.GB * task.attempt }
        time   = { 24.h * task.attempt }
    }

    // Cactus: pakai .sif lokal — tidak perlu pull dari internet
    withName: 'CACTUS_MINIGRAPH' {
        container = "${System.getProperty('user.home')}/cactus_v2.9.0.sif"
    }
}

// Singularity untuk Cactus (tools lain via conda)
singularity {
    enabled    = true
    autoMounts = true
    runOptions = '--bind /mgpfs'   // mount filesystem HPC ke dalam container
}

// Docker DIMATIKAN di HPC (tidak diizinkan di cluster multi-user)
docker {
    enabled = false
}
