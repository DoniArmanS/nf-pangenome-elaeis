/*
 * conf/hpc.config — Konfigurasi untuk HPC Mahameru BRIN
 * Executor: SLURM
 * Max resource: 128 CPU, 64 GB RAM (sesuai batasan di proposal)
 */

params {
    max_cpus   = 128
    max_memory = "64.GB"
    max_time   = "48.h"
}

process {
    executor = 'slurm'
    queue    = 'normal'

    withLabel: process_low {
        cpus   = { 4 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    withLabel: process_medium {
        cpus   = { 16 * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }

    withLabel: process_high {
        cpus   = { 32 * task.attempt }
        memory = { 64.GB * task.attempt }
        time   = { 24.h * task.attempt }
    }
}

singularity {
    enabled    = true
    autoMounts = true
}
